generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_owner
  platform_admin
  country_manager
  support_admin
  auditor
}

enum OrganizationRole {
  org_owner
  org_admin
  member
  chef_owner
  chef_staff
  restaurant_owner
  restaurant_staff
  grocery_partner_admin
}

enum OrganizationType {
  household
  chef_business
  restaurant
  grocery_partner
  internal_admin
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum OrganizationStatus {
  active
  paused
  suspended
  disabled
}

enum MeasurementSystem {
  metric
  imperial
  mixed
}

enum UserStatus {
  active
  suspended
  disabled
}

enum NotificationStatus {
  unread
  read
  archived
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

model User {
  id                         String                         @id @default(cuid())
  email                      String                         @unique
  passwordHash               String
  fullName                   String
  status                     UserStatus                     @default(active)
  platformRole               PlatformRole?
  preferredLocale            String?                        @default("en-US")
  preferredTimezone          String?                        @default("UTC")
  lastLoginAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  sessions                   Session[]
  memberships                Membership[]
  countryAssignments         CountryAssignment[]
  auditLogs                  AuditLog[]
  emailLogs                  EmailLog[]
  apiKeys                    ApiKey[]
  groceryLists               GroceryList[]
  groceryListShares          GroceryListShare[]             @relation("GroceryListShareCreatedBy")
  groceryListExports         GroceryListExport[]            @relation("GroceryListExportCreatedBy")
  createdMealPlans           MealPlan[]                     @relation("MealPlanCreatedBy")
  discoveryRuns              YouTubeDiscoveryRun[]          @relation("DiscoveryRunRequestedBy")
  reviewedCandidates         YouTubeVideoCandidate[]        @relation("CandidateReviewedBy")
  favoriteRecipesCreated     FavoriteRecipe[]               @relation("FavoriteRecipeCreatedBy")
  homeChefRequestsCreated    HomeChefRequest[]              @relation("HomeChefRequestCreatedBy")
  homeChefMessagesSent       HomeChefRequestMessage[]       @relation("HomeChefRequestMessageSender")
  homeChefStatusChanges      HomeChefRequestStatusHistory[] @relation("HomeChefRequestStatusChangedBy")
  chefReviews                ChefReview[]
  restaurantFallbackSearches RestaurantFallbackSearch[]     @relation("RestaurantSearchCreatedBy")
  notifications              Notification[]
  notificationPreference     NotificationPreference?
}

model Session {
  id                   String        @id @default(cuid())
  tokenHash            String        @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Organization {
  id                         String                       @id @default(cuid())
  name                       String
  slug                       String                       @unique
  organizationType           OrganizationType
  status                     OrganizationStatus           @default(active)
  organizationId             String                       @unique
  countryCode                String
  currencyCode               String
  defaultTimezone            String
  defaultLocale              String
  measurementSystem          MeasurementSystem
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  memberships                Membership[]
  country                    Country                      @relation(fields: [countryCode], references: [countryCode])
  sessions                   Session[]
  auditLogs                  AuditLog[]
  featureFlags               FeatureFlag[]
  billingSubscriptions       BillingSubscription[]
  apiKeys                    ApiKey[]
  storageFiles               StorageFile[]
  emailLogs                  EmailLog[]
  countryConfigs             CountryConfig[]
  groceryLists               GroceryList[]
  groceryListShares          GroceryListShare[]
  groceryListExports         GroceryListExport[]
  mealPlans                  MealPlan[]
  mealPlanPreference         MealPlanPreference?
  householdProfile           HouseholdProfile?
  householdPreferences       HouseholdPreference[]
  preferredCuisines          HouseholdPreferredCuisine[]
  avoidedIngredients         AvoidedIngredient[]
  favoriteRecipes            FavoriteRecipe[]
  pantryItems                HouseholdPantryItem[]
  shoppingPreference         HouseholdShoppingPreference?
  chefProfile                ChefProfile?
  homeChefRequests           HomeChefRequest[]            @relation("HomeChefRequestOrganization")
  assignedChefRequests       HomeChefRequest[]            @relation("HomeChefRequestAssignedChefOrganization")
  chefReviews                ChefReview[]
  restaurantFallbackSearches RestaurantFallbackSearch[]
  savedRestaurants           SavedRestaurant[]
  notifications              Notification[]

  @@index([countryCode])
  @@index([status])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([status])
}

model Country {
  id                 String              @id @default(cuid())
  countryCode        String              @unique
  countryName        String
  currencyCode       String
  defaultTimezone    String
  defaultLocale      String
  measurementSystem  MeasurementSystem
  phoneCountryCode   String
  isActive           Boolean             @default(true)
  supportedModules   String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizations      Organization[]
  countryAssignments CountryAssignment[]
  countryConfigs     CountryConfig[]
  auditLogs          AuditLog[]
  mealPlans          MealPlan[]
  groceryPartners    GroceryPartner[]
  notifications      Notification[]
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String?
  userId         String?
  countryCode    String?
  type           String
  title          String
  body           String
  actionUrl      String?
  status         NotificationStatus   @default(unread)
  priority       NotificationPriority @default(normal)
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Country?             @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([countryCode])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  homeChefUpdates     Boolean  @default(true)
  chefRequestMessages Boolean  @default(true)
  groceryReminders    Boolean  @default(true)
  mealPlanReminders   Boolean  @default(true)
  adminAlerts         Boolean  @default(true)
  marketingEmails     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CountryAssignment {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([countryCode])
}

model CountryConfig {
  id                String             @id @default(cuid())
  organizationId    String?
  countryCode       String
  configKey         String
  configValue       Json
  measurementSystem MeasurementSystem?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([organizationId, countryCode, configKey])
  @@index([countryCode])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  countryCode    String?
  action         String
  targetType     String
  targetId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  country        Country?      @relation(fields: [countryCode], references: [countryCode], onDelete: SetNull)

  @@index([action])
  @@index([organizationId])
  @@index([countryCode])
  @@index([createdAt])
}

model FeatureFlag {
  id             String        @id @default(cuid())
  key            String
  name           String
  description    String?
  enabled        Boolean       @default(false)
  organizationId String?
  countryCode    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([key, organizationId, countryCode])
  @@index([organizationId])
  @@index([countryCode])
}

model BillingSubscription {
  id               String       @id @default(cuid())
  organizationId   String
  countryCode      String
  provider         String
  externalId       String?
  status           String
  planCode         String
  currencyCode     String
  billingPeriod    String
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([countryCode])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  keyHash        String
  label          String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model StorageFile {
  id             String       @id @default(cuid())
  organizationId String
  countryCode    String
  storageKey     String
  bucket         String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey])
  @@index([organizationId])
  @@index([countryCode])
}

model EmailLog {
  id                String        @id @default(cuid())
  organizationId    String?
  userId            String?
  countryCode       String?
  templateKey       String
  recipientEmail    String
  deliveryStatus    String
  providerMessageId String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([countryCode])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Food Foundation ─────────────────────────────────────────────────────────

enum UnitType {
  mass
  volume
  count
  length
  package
  custom
}

enum UnitSystem {
  metric
  imperial
  mixed
  traditional
}

enum IngredientCategory {
  vegetable
  fruit
  meat
  poultry
  seafood
  dairy
  grain
  lentil
  spice
  herb
  oil
  condiment
  nut
  sweetener
  beverage
  packaged
  other
}

enum RecipeDifficulty {
  easy
  medium
  hard
  expert
}

enum SpiceLevel {
  mild
  medium
  hot
  extra_hot
}

enum RecipeVisibility {
  global
  organization
  private
}

enum RecipeSourceType {
  platform
  organization
  imported
  user_created
}

enum MediaReferenceType {
  youtube
  image
  article
  other
}

enum MediaProvider {
  youtube
  manual
  other
}

enum YouTubeDiscoveryRunStatus {
  queued
  running
  completed
  failed
}

enum YouTubeVideoCandidateStatus {
  pending
  approved
  rejected
  imported
}

enum VideoAvailabilityStatus {
  unchecked
  available
  unavailable
  restricted
  unknown
}

enum CookingSkillLevel {
  beginner
  intermediate
  advanced
  expert
}

enum AvoidedIngredientSeverity {
  preference
  avoid
  strict
}

enum PreferredDeliveryMethod {
  pickup
  delivery
  in_store
  no_preference
}

enum HomeChefRequestStatus {
  draft
  submitted
  reviewing
  matched
  quoted
  accepted
  declined
  cancelled
  completed
}

enum HomeChefRequestType {
  recipe
  meal_plan
  occasion
  weekly_cooking
  daily_cooking
  custom
}

enum GenderPreference {
  no_preference
  female_preferred
  male_preferred
}

enum HomeChefMessageSenderRole {
  household
  admin
  chef
  support
}

enum ChefProfileStatus {
  draft
  active
  paused
  suspended
  disabled
}

enum ChefVerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum ChefServiceType {
  daily_cooking
  weekly_cooking
  occasion
  meal_prep
  recipe_specific
  custom
}

enum ChefPriceUnit {
  per_visit
  per_day
  per_week
  per_event
  per_guest
  custom
}

enum ReviewStatus {
  pending
  published
  hidden
}

model Cuisine {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  description                String?
  countryCode                String?
  isGlobal                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  recipes                    Recipe[]
  householdPreferredCuisines HouseholdPreferredCuisine[]

  @@index([countryCode])
}

model Unit {
  id                         String                  @id @default(cuid())
  code                       String                  @unique
  name                       String
  pluralName                 String
  type                       UnitType
  system                     UnitSystem
  symbol                     String?
  isBaseUnit                 Boolean                 @default(false)
  isGlobal                   Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  ingredients                Ingredient[]            @relation("IngredientDefaultUnit")
  recipeIngredients          RecipeIngredient[]
  conversionsFrom            UnitConversion[]        @relation("ConversionFromUnit")
  conversionsTo              UnitConversion[]        @relation("ConversionToUnit")
  groceryListItems           GroceryListItem[]
  originalGroceryItemSources GroceryListItemSource[] @relation("SourceOriginalUnit")
  scaledGroceryItemSources   GroceryListItemSource[] @relation("SourceScaledUnit")
  householdPantryItems       HouseholdPantryItem[]

  @@index([type])
  @@index([system])
}

model Ingredient {
  id                      String                     @id @default(cuid())
  organizationId          String?
  countryCode             String?
  name                    String
  canonicalName           String
  slug                    String
  category                IngredientCategory
  defaultUnitId           String?
  densityGramPerMl        Float?
  averagePieceWeightGrams Float?
  isGlobal                Boolean                    @default(true)
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  defaultUnit             Unit?                      @relation("IngredientDefaultUnit", fields: [defaultUnitId], references: [id])
  aliases                 IngredientAlias[]
  recipeIngredients       RecipeIngredient[]
  unitConversions         UnitConversion[]
  groceryListItems        GroceryListItem[]
  groceryWarnings         GroceryConversionWarning[]
  avoidedIngredients      AvoidedIngredient[]
  householdPantryItems    HouseholdPantryItem[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([category])
  @@index([isGlobal])
}

model IngredientAlias {
  id           String     @id @default(cuid())
  ingredientId String
  alias        String
  language     String?
  countryCode  String?
  confidence   Float      @default(1.0)
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([alias])
}

model UnitConversion {
  id           String      @id @default(cuid())
  fromUnitId   String
  toUnitId     String
  ingredientId String?
  multiplier   Float
  offset       Float?
  confidence   Float       @default(1.0)
  notes        String?
  isGlobal     Boolean     @default(true)
  countryCode  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  fromUnit     Unit        @relation("ConversionFromUnit", fields: [fromUnitId], references: [id])
  toUnit       Unit        @relation("ConversionToUnit", fields: [toUnitId], references: [id])
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([fromUnitId, toUnitId])
  @@index([ingredientId])
  @@index([isGlobal])
}

model Recipe {
  id                         String                     @id @default(cuid())
  organizationId             String?
  countryCode                String?
  cuisineId                  String
  name                       String
  slug                       String
  description                String?
  story                      String?
  difficulty                 RecipeDifficulty
  spiceLevel                 SpiceLevel
  prepMinutes                Int
  cookMinutes                Int
  restMinutes                Int?
  servings                   Int
  servingUnit                String                     @default("serving")
  visibility                 RecipeVisibility           @default(global)
  sourceType                 RecipeSourceType
  createdById                String?
  isGlobal                   Boolean                    @default(false)
  isPublished                Boolean                    @default(false)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  cuisine                    Cuisine                    @relation(fields: [cuisineId], references: [id])
  ingredients                RecipeIngredient[]
  steps                      RecipeStep[]
  mediaRefs                  RecipeMediaReference[]
  dietaryTags                RecipeDietaryTag[]
  groceryListRecipes         GroceryListRecipe[]
  groceryItemSources         GroceryListItemSource[]
  groceryWarnings            GroceryConversionWarning[]
  mealPlanEntries            MealPlanEntry[]
  discoveryRuns              YouTubeDiscoveryRun[]
  youtubeCandidates          YouTubeVideoCandidate[]
  favoriteRecipes            FavoriteRecipe[]
  homeChefRequests           HomeChefRequest[]
  chefSpecialties            ChefSpecialtyRecipe[]
  restaurantFallbackSearches RestaurantFallbackSearch[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([cuisineId])
  @@index([isPublished])
  @@index([visibility])
}

model RecipeIngredient {
  id              String     @id @default(cuid())
  recipeId        String
  ingredientId    String
  quantity        Float
  unitId          String
  preparationNote String?
  section         String?
  isOptional      Boolean    @default(false)
  displayOrder    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  recipe          Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  unit            Unit       @relation(fields: [unitId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeStep {
  id              String  @id @default(cuid())
  recipeId        String
  stepNumber      Int
  title           String?
  instruction     String
  durationMinutes Int?
  temperature     String?
  tips            String?
  displayOrder    Int     @default(0)
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId])
}

model RecipeMediaReference {
  id                        String                  @id @default(cuid())
  recipeId                  String
  type                      MediaReferenceType
  provider                  MediaProvider           @default(manual)
  title                     String
  url                       String
  normalizedUrl             String?
  embedUrl                  String?
  externalId                String?
  thumbnailUrl              String?
  language                  String?
  creatorName               String?
  durationSeconds           Int?
  isPrimary                 Boolean                 @default(false)
  displayOrder              Int                     @default(0)
  notes                     String?
  availabilityStatus        VideoAvailabilityStatus @default(unchecked)
  lastAvailabilityCheckedAt DateTime?
  unavailableReason         String?
  isEmbeddable              Boolean                 @default(false)
  isPublic                  Boolean                 @default(false)
  uploadStatus              String?
  liveBroadcastContent      String?
  qualityDefinition         String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  recipe                    Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([isPrimary])
}

model DietaryTag {
  id      String             @id @default(cuid())
  name    String             @unique
  slug    String             @unique
  recipes RecipeDietaryTag[]
}

model RecipeDietaryTag {
  recipeId     String
  dietaryTagId String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietaryTagId])
}

model MealTypeOption {
  id           String @id @default(cuid())
  name         String @unique
  slug         String @unique
  displayOrder Int    @default(0)
}

// ─── Grocery Engine ───────────────────────────────────────────────────────────

enum MealPlanStatus {
  draft
  active
  completed
  archived
}

enum MealPlanEntryStatus {
  planned
  cooked
  skipped
  ordered_instead
  replaced
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  dessert
  side
  prep
}

enum GroceryListStatus {
  draft
  active
  completed
  archived
}

enum GroceryListSourceType {
  manual
  recipes
  meal_plan
}

enum GroceryMergeStatus {
  merged
  separate
  needs_review
  conversion_failed
}

enum GroceryConfidence {
  exact
  high
  medium
  low
  unknown
}

enum WarningSeverity {
  info
  warning
  error
}

enum GroceryPartnerStatus {
  draft
  active
  paused
  disabled
}

enum GroceryIntegrationType {
  manual_link
  affiliate_link
  api_placeholder
  export_only
}

enum GroceryListExportType {
  pdf
  csv
  print
  copy
  share_link
}

model GroceryList {
  id                 String                     @id @default(cuid())
  organizationId     String
  countryCode        String?
  createdById        String
  mealPlanId         String?
  name               String
  status             GroceryListStatus          @default(draft)
  sourceType         GroceryListSourceType      @default(recipes)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  householdSize      Int?
  notes              String?
  calculationVersion Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  organization       Organization               @relation(fields: [organizationId], references: [id])
  createdBy          User                       @relation(fields: [createdById], references: [id])
  mealPlan           MealPlan?                  @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  recipes            GroceryListRecipe[]
  items              GroceryListItem[]
  warnings           GroceryConversionWarning[]
  shares             GroceryListShare[]
  exports            GroceryListExport[]

  @@index([organizationId])
  @@index([createdById])
  @@index([mealPlanId])
  @@index([status])
}

model GroceryPartner {
  id               String                 @id @default(cuid())
  countryCode      String
  name             String
  slug             String                 @unique
  status           GroceryPartnerStatus   @default(draft)
  websiteUrl       String?
  logoUrl          String?
  supportedRegions Json?
  integrationType  GroceryIntegrationType @default(export_only)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  country          Country                @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@index([countryCode])
  @@index([status])
}

model GroceryListShare {
  id             String       @id @default(cuid())
  groceryListId  String
  organizationId String
  tokenHash      String       @unique
  expiresAt      DateTime?
  createdById    String
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  groceryList    GroceryList  @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
