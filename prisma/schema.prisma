// ─── YouTube Discovery ────────────────────────────────────────────────────────

model YouTubeDiscoveryRun {
  id                String                    @id @default(cuid())
  recipeId          String?
  organizationId    String?
  countryCode       String?
  requestedByUserId String
  status            YouTubeDiscoveryRunStatus @default(queued)
  queryCount        Int                       @default(0)
  candidatesFound   Int                       @default(0)
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  recipe            Recipe?                   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  requestedBy       User                      @relation("DiscoveryRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  candidates        YouTubeVideoCandidate[]

  @@index([recipeId])
  @@index([organizationId])
  @@index([status])
}

model YouTubeVideoCandidate {
  id                        String                      @id @default(cuid())
  discoveryRunId            String
  recipeId                  String
  providerVideoId           String
  title                     String
  description               String?
  channelId                 String?
  channelTitle              String?
  thumbnailUrl              String?
  publishedAt               DateTime?
  durationSeconds           Int?
  viewCount                 BigInt?
  likeCount                 BigInt?
  commentCount              BigInt?
  searchQuery               String
  score                     Float                       @default(0)
  scoreReasonsJson          Json                        @default("[]")
  professionalSignalsJson   Json                        @default("[]")
  rejectionReasonsJson      Json?
  status                    YouTubeVideoCandidateStatus @default(pending)
  reviewedByUserId          String?
  reviewedAt                DateTime?
  availabilityStatus        VideoAvailabilityStatus     @default(unchecked)
  lastAvailabilityCheckedAt DateTime?
  unavailableReason         String?
  isEmbeddable              Boolean                     @default(false)
  isPublic                  Boolean                     @default(false)
  uploadStatus              String?
  liveBroadcastContent      String?
  qualityDefinition         String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  discoveryRun              YouTubeDiscoveryRun         @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  recipe                    Recipe                      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reviewedBy                User?                       @relation("CandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([recipeId, providerVideoId])
  @@index([discoveryRunId])
  @@index([recipeId])
  @@index([status])
}

// ─── Restaurant Fallback ──────────────────────────────────────────────────────

enum RestaurantFallbackSearchStatus {
  pending
  completed
  failed
}

enum RestaurantProvider {
  maptiler
  manual
}

model RestaurantFallbackSearch {
  id              String                         @id @default(cuid())
  organizationId  String
  countryCode     String
  createdById     String
  recipeId        String?
  mealPlanEntryId String?
  query           String
  latitude        Float?
  longitude       Float?
  city            String?
  region          String?
  status          RestaurantFallbackSearchStatus @default(pending)
  resultCount     Int                            @default(0)
  errorMessage    String?
  createdAt       DateTime                       @default(now())
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                           @relation("RestaurantSearchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recipe          Recipe?                        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  results         RestaurantFallbackResult[]

  @@index([organizationId])
  @@index([countryCode])
  @@index([recipeId])
  @@index([status])
}

model RestaurantFallbackResult {
  id              String                   @id @default(cuid())
  searchId        String
  organizationId  String
  countryCode     String
  provider        RestaurantProvider       @default(maptiler)
  providerPlaceId String?
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  category        String?
  distanceMeters  Float?
  mapUrl          String?
  rawJson         Json?
  createdAt       DateTime                 @default(now())
  search          RestaurantFallbackSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@index([organizationId])
}

model SavedRestaurant {
  id              String             @id @default(cuid())
  organizationId  String
  countryCode     String
  provider        RestaurantProvider @default(manual)
  providerPlaceId String?
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  category        String?
  mapUrl          String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([countryCode])
}
