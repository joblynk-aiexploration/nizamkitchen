generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_owner
  platform_admin
  country_manager
  support_admin
  auditor
}

enum OrganizationRole {
  org_owner
  org_admin
  member
  chef_owner
  chef_staff
  restaurant_owner
  restaurant_staff
  grocery_partner_admin
}

enum OrganizationType {
  household
  chef_business
  restaurant
  grocery_partner
  internal_admin
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum OrganizationStatus {
  active
  paused
  suspended
  disabled
}

enum MeasurementSystem {
  metric
  imperial
  mixed
}

enum UserStatus {
  active
  suspended
  disabled
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  fullName           String
  status             UserStatus           @default(active)
  platformRole       PlatformRole?
  preferredLocale    String?              @default("en-US")
  preferredTimezone  String?              @default("UTC")
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  memberships        Membership[]
  countryAssignments CountryAssignment[]
  auditLogs          AuditLog[]
  emailLogs          EmailLog[]
  apiKeys            ApiKey[]
}

model Session {
  id                   String        @id @default(cuid())
  tokenHash            String        @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  organizationType     OrganizationType
  status               OrganizationStatus    @default(active)
  organizationId       String                @unique
  countryCode          String
  currencyCode         String
  defaultTimezone      String
  defaultLocale        String
  measurementSystem    MeasurementSystem
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  country              Country               @relation(fields: [countryCode], references: [countryCode])
  sessions             Session[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  billingSubscriptions BillingSubscription[]
  apiKeys              ApiKey[]
  storageFiles         StorageFile[]
  emailLogs            EmailLog[]
  countryConfigs       CountryConfig[]

  @@index([countryCode])
  @@index([status])
}

model Membership {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  status         MembershipStatus   @default(active)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([status])
}

model Country {
  id                 String             @id @default(cuid())
  countryCode        String             @unique
  countryName        String
  currencyCode       String
  defaultTimezone    String
  defaultLocale      String
  measurementSystem  MeasurementSystem
  phoneCountryCode   String
  isActive           Boolean            @default(true)
  supportedModules   String[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organizations      Organization[]
  countryAssignments CountryAssignment[]
  countryConfigs     CountryConfig[]
  auditLogs          AuditLog[]
}

model CountryAssignment {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([countryCode])
}

model CountryConfig {
  id                String             @id @default(cuid())
  organizationId    String?
  countryCode       String
  configKey         String
  configValue       Json
  measurementSystem MeasurementSystem?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([organizationId, countryCode, configKey])
  @@index([countryCode])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  countryCode    String?
  action         String
  targetType     String
  targetId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  country        Country?      @relation(fields: [countryCode], references: [countryCode], onDelete: SetNull)

  @@index([action])
  @@index([organizationId])
  @@index([countryCode])
  @@index([createdAt])
}

model FeatureFlag {
  id             String        @id @default(cuid())
  key            String
  name           String
  description    String?
  enabled        Boolean       @default(false)
  organizationId String?
  countryCode    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([key, organizationId, countryCode])
  @@index([organizationId])
  @@index([countryCode])
}

model BillingSubscription {
  id               String       @id @default(cuid())
  organizationId   String
  countryCode      String
  provider         String
  externalId       String?
  status           String
  planCode         String
  currencyCode     String
  billingPeriod    String
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([countryCode])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  keyHash        String
  label          String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model StorageFile {
  id             String       @id @default(cuid())
  organizationId String
  countryCode    String
  storageKey     String
  bucket         String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey])
  @@index([organizationId])
  @@index([countryCode])
}

model EmailLog {
  id                String        @id @default(cuid())
  organizationId    String?
  userId            String?
  countryCode       String?
  templateKey       String
  recipientEmail    String
  deliveryStatus    String
  providerMessageId String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([countryCode])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
