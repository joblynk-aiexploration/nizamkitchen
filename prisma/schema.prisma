  @@index([countryCode])
}

model Unit {
  id                         String                  @id @default(cuid())
  code                       String                  @unique
  name                       String
  pluralName                 String
  type                       UnitType
  system                     UnitSystem
  symbol                     String?
  isBaseUnit                 Boolean                 @default(false)
  isGlobal                   Boolean                 @default(true)
