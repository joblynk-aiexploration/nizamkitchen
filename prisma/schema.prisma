generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_owner
  platform_admin
  country_manager
  support_admin
  auditor
}

enum OrganizationRole {
  org_owner
  org_admin
  member
  household_member
  chef_owner
  chef_staff
  home_catering_owner
  home_catering_staff
  restaurant_owner
  restaurant_staff
  grocery_partner_admin
}

enum PermissionAction {
  create
  read
  update
  delete
  archive
  restore
  approve
  reject
  export
  manage
  configure
  impersonate_placeholder
  refund
  payout
  verify
  moderate
}

enum PermissionEffect {
  allow
  deny
}

enum RoleScope {
  platform
  organization
  country
}

enum OrganizationType {
  household
  chef_business
  home_catering
  restaurant
  grocery_partner
  internal_admin
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum OrganizationStatus {
  active
  paused
  suspended
  disabled
}

enum MeasurementSystem {
  metric
  imperial
  mixed
}

enum LocaleTextDirection {
  ltr
  rtl
}

enum LocalizationStatus {
  active
  disabled
}

enum TranslationStatus {
  draft
  published
  disabled
}

enum UserStatus {
  active
  suspended
  disabled
}

enum NotificationStatus {
  unread
  read
  archived
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum SupportTicketType {
  bug
  feedback
  feature_request
  account_help
  billing
  other
}

enum SupportTicketStatus {
  open
  in_review
  waiting_on_user
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum StorageProvider {
  aws_s3
  s3_compatible
  local_dev
}

enum StorageConfigurationStatus {
  draft
  active
  disabled
  error
}

enum StorageTestStatus {
  not_tested
  success
  failed
}

enum StorageFileVisibility {
  private
  organization
  public
}

enum StorageFileStatus {
  active
  archived
  deleted
  quarantined
}

enum StorageFilePurpose {
  user_profile_photo
  user_cover_photo
  business_profile_photo
  business_cover_photo
  recipe_image
  menu_item_photo
  chef_document
  home_catering_document
  restaurant_document
  verification_document
  business_license_document
  food_handler_certificate
  kitchen_photo
  background_check_consent
  support_attachment
  order_attachment
  grocery_attachment
  data_export
  general_document
  admin_dropbox
}

enum StorageModule {
  users
  organizations
  recipes
  menus
  home_chefs
  home_catering
  restaurants
  orders
  grocery
  support
  privacy
  admin_dropbox
  system
}

enum StorageFileAction {
  uploaded
  downloaded
  viewed
  signed_url_created
  deleted
  archived
  restored
}

enum LocationProvider {
  google
  manual
}

enum LocationVisibility {
  private
  organization
  public_city_only
  public_full
}

enum IntegrationProvider {
  google_maps
  google_places
  google_geocoding
  google_oauth
  facebook_oauth
  google_analytics
  google_search_console
  google_recaptcha
  google_adsense
  youtube_data
  aws_s3
  s3_compatible
  smtp
  stripe
  paypal
  google_pay
  stripe_identity
  stripe_connect
  persona_placeholder
  checkr_placeholder
  kyc_provider
  background_check_provider
  custom
}

enum IntegrationCategory {
  maps
  auth
  analytics
  seo
  ads
  storage
  payments
  email
  verification
  security
  marketplace
  other
}

enum IntegrationStatus {
  draft
  active
  disabled
  error
}

enum IntegrationEnvironment {
  sandbox
  production
  development
}

enum IntegrationTestStatus {
  not_tested
  success
  failed
}

enum SeoScope {
  global
  page
  recipe
  seller_profile
  city_page
  country_page
  menu_template
  custom_path
}

enum RobotsDirective {
  index_follow
  noindex_follow
  noindex_nofollow
  index_nofollow
}

enum OAuthProvider {
  google
  facebook
}

model User {
  id                               String                         @id @default(cuid())
  email                            String                         @unique
  passwordHash                     String
  fullName                         String
  status                           UserStatus                     @default(active)
  platformRole                     PlatformRole?
  profilePhotoFileId               String?
  coverPhotoFileId                 String?
  headline                         String?
  bio                              String?
  location                         String?
  locationText                     String?
  phone                            String?
  preferredLanguage                String?
  publicProfileEnabled             Boolean                        @default(false)
  preferredLocale                  String?                        @default("en-US")
  preferredTimezone                String?                        @default("UTC")
  lastLoginAt                      DateTime?
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  sessions                         Session[]
  memberships                      Membership[]
  countryAssignments               CountryAssignment[]
  auditLogs                        AuditLog[]
  emailLogs                        EmailLog[]
  apiKeys                          ApiKey[]
  groceryLists                     GroceryList[]
  groceryListShares                GroceryListShare[]             @relation("GroceryListShareCreatedBy")
  groceryListExports               GroceryListExport[]            @relation("GroceryListExportCreatedBy")
  createdMealPlans                 MealPlan[]                     @relation("MealPlanCreatedBy")
  discoveryRuns                    YouTubeDiscoveryRun[]          @relation("DiscoveryRunRequestedBy")
  reviewedCandidates               YouTubeVideoCandidate[]        @relation("CandidateReviewedBy")
  favoriteRecipesCreated           FavoriteRecipe[]               @relation("FavoriteRecipeCreatedBy")
  homeChefRequestsCreated          HomeChefRequest[]              @relation("HomeChefRequestCreatedBy")
  homeChefMessagesSent             HomeChefRequestMessage[]       @relation("HomeChefRequestMessageSender")
  homeChefStatusChanges            HomeChefRequestStatusHistory[] @relation("HomeChefRequestStatusChangedBy")
  chefReviews                      ChefReview[]
  restaurantFallbackSearches       RestaurantFallbackSearch[]     @relation("RestaurantSearchCreatedBy")
  notifications                    Notification[]
  notificationPreference           NotificationPreference?
  localizationPreference           UserLocalizationPreference?
  supportTicketsCreated            SupportTicket[]                @relation("SupportTicketCreatedBy")
  supportTicketsAssigned           SupportTicket[]                @relation("SupportTicketAssignedTo")
  supportTicketComments            SupportTicketComment[]
  foodOrders                       FoodOrder[]                    @relation("FoodOrderCustomerUser")
  foodOrderMessages                FoodOrderMessage[]             @relation("FoodOrderMessageSender")
  foodOrderStatusChanges           FoodOrderStatusHistory[]       @relation("FoodOrderStatusChangedBy")
  foodOrderFulfillmentEvents       FoodOrderFulfillmentEvent[]    @relation("FoodOrderFulfillmentEventActor")
  marketplaceReviewsWritten        MarketplaceReview[]            @relation("MarketplaceReviewReviewer")
  marketplaceReviewSellerReplies   MarketplaceReview[]            @relation("MarketplaceReviewSellerReplyBy")
  marketplaceReviewsModerated      MarketplaceReview[]            @relation("MarketplaceReviewModeratedBy")
  marketplaceReviewReportsCreated  MarketplaceReviewReport[]      @relation("MarketplaceReviewReportReporter")
  marketplaceReviewReportsReviewed MarketplaceReviewReport[]      @relation("MarketplaceReviewReportReviewedBy")
  trustComplaintsCreated           TrustComplaint[]               @relation("TrustComplaintReporter")
  trustComplaintsReviewed          TrustComplaint[]               @relation("TrustComplaintReviewedBy")
  storageConfigurationsCreated     StorageConfiguration[]         @relation("StorageConfigurationCreatedBy")
  storageConfigurationsUpdated     StorageConfiguration[]         @relation("StorageConfigurationUpdatedBy")
  storageFilesUploaded             StorageFile[]                  @relation("StorageFileUploadedBy")
  storageFileAccessLogs            StorageFileAccessLog[]
  storageFileVersions              StorageFileVersion[]           @relation("StorageFileVersionCreatedBy")
  reviewedSellerProfiles           SellerVerificationProfile[]    @relation("SellerVerificationProfileReviewedBy")
  reviewedVerificationItems        SellerVerificationItem[]       @relation("SellerVerificationItemReviewedBy")
  reviewedFoodSafetyCertificates   FoodSafetyCertificate[]        @relation("FoodSafetyCertificateReviewedBy")
  reviewedSellerPermits            SellerPermit[]                 @relation("SellerPermitReviewedBy")
  acceptedSellerAttestations       SellerAttestation[]            @relation("SellerAttestationAcceptedBy")
  requestedBackgroundChecks        SellerBackgroundCheck[]        @relation("SellerBackgroundCheckRequestedBy")
  reviewedKitchenSafety            KitchenSafetyReview[]          @relation("KitchenSafetyReviewReviewedBy")
  reviewedSellerTrials             SellerTrialReview[]            @relation("SellerTrialReviewReviewedBy")
  kycProviderConfigurationsCreated KycProviderConfiguration[]     @relation("KycProviderConfigurationCreatedBy")
  kycProviderConfigurationsUpdated KycProviderConfiguration[]     @relation("KycProviderConfigurationUpdatedBy")
  identityVerifications            IdentityVerification[]
  sellerVerificationOverrides      SellerVerificationOverride[]   @relation("SellerVerificationOverrideGrantedBy")
  permissionOverrides              UserPermissionOverride[]        @relation("UserPermissionOverrideUser")
  permissionOverridesCreated       UserPermissionOverride[]        @relation("UserPermissionOverrideCreatedBy")
  resolvedSystemAlerts             SystemAlert[]                  @relation("SystemAlertResolvedBy")
  marketplacePoliciesCreated       MarketplacePolicy[]             @relation("MarketplacePolicyCreatedBy")
  marketplacePoliciesUpdated       MarketplacePolicy[]             @relation("MarketplacePolicyUpdatedBy")
  marketplacePolicyOverrides       MarketplacePolicyOverride[]      @relation("MarketplacePolicyOverrideUser")
  marketplacePolicyOverridesCreated MarketplacePolicyOverride[]     @relation("MarketplacePolicyOverrideCreatedBy")
  marketplacePolicyOverridesRevoked MarketplacePolicyOverride[]     @relation("MarketplacePolicyOverrideRevokedBy")
  marketplacePolicyLogs            MarketplacePolicyEvaluationLog[]
  legalDocumentsCreated            LegalDocument[]                  @relation("LegalDocumentCreatedBy")
  legalDocumentsPublished          LegalDocument[]                  @relation("LegalDocumentPublishedBy")
  legalDocumentAcceptances         LegalDocumentAcceptance[]
  legalConsentEvents               LegalConsentEvent[]
  dataPrivacyRequests              DataPrivacyRequest[]             @relation("DataPrivacyRequestUser")
  dataPrivacyRequestsCreated       DataPrivacyRequest[]             @relation("DataPrivacyRequestRequestedBy")
  dataPrivacyRequestsCompleted     DataPrivacyRequest[]             @relation("DataPrivacyRequestCompletedBy")
  dataRetentionPoliciesCreated     DataRetentionPolicy[]            @relation("DataRetentionPolicyCreatedBy")
  dataRetentionPoliciesUpdated     DataRetentionPolicy[]            @relation("DataRetentionPolicyUpdatedBy")
  platformIntegrationsCreated      PlatformIntegration[]            @relation("PlatformIntegrationCreatedBy")
  platformIntegrationsUpdated      PlatformIntegration[]            @relation("PlatformIntegrationUpdatedBy")
  platformIntegrationCredentialsCreated PlatformIntegrationCredential[] @relation("PlatformIntegrationCredentialCreatedBy")
  platformIntegrationCredentialsUpdated PlatformIntegrationCredential[] @relation("PlatformIntegrationCredentialUpdatedBy")
  platformIntegrationTests         PlatformIntegrationTestLog[]     @relation("PlatformIntegrationTestedBy")
  oauthAccounts                    OAuthAccount[]
  userActivities                   UserActivity[]
  privacySetting                   UserPrivacySetting?
  dishTemplatesCreated             DishTemplate[]                   @relation("DishTemplateCreatedBy")
  dishTemplatesUpdated             DishTemplate[]                   @relation("DishTemplateUpdatedBy")
  menuTemplatesCreated             MenuTemplate[]                   @relation("MenuTemplateCreatedBy")
  menuTemplatesUpdated             MenuTemplate[]                   @relation("MenuTemplateUpdatedBy")
  seoSettingsCreated               SeoSetting[]                     @relation("SeoSettingCreatedBy")
  seoSettingsUpdated               SeoSetting[]                     @relation("SeoSettingUpdatedBy")
  locations                        Location[]
  promotionsCreated                Promotion[]                      @relation("PromotionCreatedBy")
  promotionsUpdated                Promotion[]                      @relation("PromotionUpdatedBy")
  cmsPagesCreated                  CmsPage[]                        @relation("CmsPageCreatedBy")
  cmsPagesUpdated                  CmsPage[]                        @relation("CmsPageUpdatedBy")
  cmsPagesPublished                CmsPage[]                        @relation("CmsPagePublishedBy")
  helpArticlesCreated              HelpArticle[]                    @relation("HelpArticleCreatedBy")
  helpArticlesUpdated              HelpArticle[]                    @relation("HelpArticleUpdatedBy")
  helpArticlesPublished            HelpArticle[]                    @relation("HelpArticlePublishedBy")
  faqsCreated                      FaqItem[]                        @relation("FaqItemCreatedBy")
  faqsUpdated                      FaqItem[]                        @relation("FaqItemUpdatedBy")
  faqsPublished                    FaqItem[]                        @relation("FaqItemPublishedBy")
}

model Session {
  id                   String        @id @default(cuid())
  tokenHash            String        @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                    String        @id @default(cuid())
  userId                String
  provider              OAuthProvider
  providerAccountId     String
  email                 String?
  emailVerified         Boolean       @default(false)
  displayName           String?
  avatarUrl             String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  rawProfileJson        Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([email])
}

model Organization {
  id                         String                       @id @default(cuid())
  name                       String
  slug                       String                       @unique
  organizationType           OrganizationType
  status                     OrganizationStatus           @default(active)
  organizationId             String                       @unique
  countryCode                String
  currencyCode               String
  logoFileId                 String?
  coverPhotoFileId           String?
  defaultTimezone            String
  defaultLocale              String
  measurementSystem          MeasurementSystem
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  memberships                Membership[]
  country                    Country                      @relation(fields: [countryCode], references: [countryCode])
  sessions                   Session[]
  auditLogs                  AuditLog[]
  featureFlags               FeatureFlag[]
  billingSubscriptions       BillingSubscription[]
  apiKeys                    ApiKey[]
  storageFiles               StorageFile[]
  emailLogs                  EmailLog[]
  countryConfigs             CountryConfig[]
  groceryLists               GroceryList[]
  groceryListShares          GroceryListShare[]
  groceryListExports         GroceryListExport[]
  mealPlans                  MealPlan[]
  mealPlanPreference         MealPlanPreference?
  householdProfile           HouseholdProfile?
  homeCateringProfile        HomeCateringProfile?
  menus                      Menu[]
  menuItems                  MenuItem[]
  householdPreferences       HouseholdPreference[]
  preferredCuisines          HouseholdPreferredCuisine[]
  avoidedIngredients         AvoidedIngredient[]
  favoriteRecipes            FavoriteRecipe[]
  pantryItems                HouseholdPantryItem[]
  shoppingPreference         HouseholdShoppingPreference?
  chefProfile                ChefProfile?
  homeChefRequests           HomeChefRequest[]            @relation("HomeChefRequestOrganization")
  assignedChefRequests       HomeChefRequest[]            @relation("HomeChefRequestAssignedChefOrganization")
  chefReviews                ChefReview[]
  restaurantFallbackSearches RestaurantFallbackSearch[]
  savedRestaurants           SavedRestaurant[]
  notifications              Notification[]
  supportTickets             SupportTicket[]
  foodOrders                 FoodOrder[]                  @relation("FoodOrderTenantOrganization")
  customerFoodOrders         FoodOrder[]                  @relation("FoodOrderCustomerOrganization")
  sellerFoodOrders           FoodOrder[]                  @relation("FoodOrderSellerOrganization")
  marketplaceReviewsWritten  MarketplaceReview[]          @relation("MarketplaceReviewCustomerOrganization")
  marketplaceReviewsReceived MarketplaceReview[]          @relation("MarketplaceReviewSellerOrganization")
  marketplaceReviewReports   MarketplaceReviewReport[]
  trustComplaintsReporter    TrustComplaint[]             @relation("TrustComplaintReporterOrganization")
  trustComplaintsSeller      TrustComplaint[]             @relation("TrustComplaintSellerOrganization")
  fulfillmentPickupLocations FulfillmentPickupLocation[]
  fulfillmentDeliveryZones   FulfillmentDeliveryZone[]
  fulfillmentTimeSlots       FulfillmentTimeSlot[]
  fulfillmentEvents          FoodOrderFulfillmentEvent[]
  businessSocialLinks        BusinessSocialLink[]
  paymentGateways            PaymentGateway[]
  paymentOrders              PaymentOrder[]
  paymentTransactions        PaymentTransaction[]
  paymentRefunds             PaymentRefund[]
  paymentDisputes            PaymentDispute[]
  accountingDocuments        AccountingDocument[]
  sellerSettlementReports    SellerSettlementReport[]
  sellerPayoutAccounts       SellerPayoutAccount[]
  sellerPayouts              SellerPayout[]
  sellerVerificationProfile  SellerVerificationProfile?
  foodSafetyCertificates     FoodSafetyCertificate[]
  sellerPermits              SellerPermit[]
  sellerAttestations         SellerAttestation[]
  sellerBackgroundChecks     SellerBackgroundCheck[]
  kitchenSafetyReviews       KitchenSafetyReview[]
  sellerTrialReviews         SellerTrialReview[]
  identityVerifications      IdentityVerification[]
  sellerVerificationOverrides SellerVerificationOverride[]
  marketplacePolicyOverrides MarketplacePolicyOverride[]
  marketplacePolicyLogs      MarketplacePolicyEvaluationLog[]
  legalDocumentAcceptances   LegalDocumentAcceptance[]
  legalConsentEvents         LegalConsentEvent[]
  dataPrivacyRequests        DataPrivacyRequest[]
  userActivities             UserActivity[]
  locations                  Location[]
  sellerPromotions           Promotion[]                 @relation("SellerPromotions")

  @@index([countryCode])
  @@index([status])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([status])
}

model Country {
  id                 String              @id @default(cuid())
  countryCode        String              @unique
  countryName        String
  currencyCode       String
  defaultTimezone    String
  defaultLocale      String
  measurementSystem  MeasurementSystem
  phoneCountryCode   String
  isActive           Boolean             @default(true)
  supportedModules   String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizations      Organization[]
  countryAssignments CountryAssignment[]
  countryConfigs     CountryConfig[]
  regionalSetting    CountryRegionalSetting?
  auditLogs          AuditLog[]
  mealPlans          MealPlan[]
  dishTemplates      DishTemplate[]
  menuTemplates      MenuTemplate[]
  groceryPartners    GroceryPartner[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String?
  userId         String?
  countryCode    String?
  type           String
  title          String
  body           String
  actionUrl      String?
  status         NotificationStatus   @default(unread)
  priority       NotificationPriority @default(normal)
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Country?             @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([countryCode])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  homeChefUpdates     Boolean  @default(true)
  chefRequestMessages Boolean  @default(true)
  groceryReminders    Boolean  @default(true)
  mealPlanReminders   Boolean  @default(true)
  adminAlerts         Boolean  @default(true)
  marketingEmails     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id             String                 @id @default(cuid())
  organizationId String?
  createdById    String?
  assignedToId   String?
  countryCode    String?
  type           SupportTicketType
  status         SupportTicketStatus    @default(open)
  priority       SupportTicketPriority  @default(normal)
  title          String
  description    String
  pageUrl        String?
  browserInfo    String?
  adminNotes     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  closedAt       DateTime?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy      User?                  @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo     User?                  @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  country        Country?               @relation(fields: [countryCode], references: [countryCode], onDelete: SetNull)
  comments       SupportTicketComment[]

  @@index([organizationId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([countryCode])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model SupportTicketComment {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@index([isInternal])
}

model CountryAssignment {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([countryCode])
}

model CountryConfig {
  id                String             @id @default(cuid())
  organizationId    String?
  countryCode       String
  configKey         String
  configValue       Json
  measurementSystem MeasurementSystem?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([organizationId, countryCode, configKey])
  @@index([countryCode])
}

model LocalizationLocale {
  id                  String                       @id @default(cuid())
  localeCode          String                       @unique
  languageName        String
  nativeName          String
  textDirection       LocaleTextDirection          @default(ltr)
  status              LocalizationStatus           @default(active)
  isDefault           Boolean                      @default(false)
  dateFormat          String
  timeFormat          String
  numberFormat        String
  createdById         String?
  updatedById         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  translations        LocalizationTranslation[]
  userPreferences     UserLocalizationPreference[]
  terminologyAliases  FoodTerminologyAlias[]

  @@index([status])
  @@index([textDirection])
}

model LocalizationTranslation {
  id              String              @id @default(cuid())
  localeCode      String
  namespace       String
  translationKey  String
  defaultValue    String
  translatedValue String
  status          TranslationStatus   @default(published)
  createdById     String?
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  locale          LocalizationLocale  @relation(fields: [localeCode], references: [localeCode], onDelete: Cascade)

  @@unique([localeCode, namespace, translationKey])
  @@index([namespace])
  @@index([status])
}

model CurrencySetting {
  id                  String             @id @default(cuid())
  currencyCode        String             @unique
  displayName         String
  symbol              String
  decimalDigits       Int                @default(2)
  status              LocalizationStatus @default(active)
  countryCodesJson    Json?
  createdById         String?
  updatedById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
}

model CountryRegionalSetting {
  id                         String             @id @default(cuid())
  countryCode                String             @unique
  defaultLocale              String
  supportedLocalesJson       Json
  supportedCurrencyCodesJson Json
  measurementSystem          MeasurementSystem
  dateFormat                 String
  timeFormat                 String
  addressFormatJson          Json
  rtlEnabled                 Boolean            @default(false)
  createdById                String?
  updatedById                String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  country                    Country            @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@index([defaultLocale])
  @@index([measurementSystem])
}

model FoodTerminologyAlias {
  id                  String                @id @default(cuid())
  localeCode          String?
  countryCode         String?
  ingredientId        String?
  sourceTerm          String
  localizedTerm       String
  transliteration     String?
  notes               String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  locale              LocalizationLocale?    @relation(fields: [localeCode], references: [localeCode], onDelete: SetNull)
  ingredient          Ingredient?            @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([localeCode])
  @@index([countryCode])
  @@index([ingredientId])
  @@index([sourceTerm])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  countryCode    String?
  action         String
  targetType     String
  targetId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
