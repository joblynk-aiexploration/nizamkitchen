generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_owner
  platform_admin
  country_manager
  support_admin
  auditor
}

enum OrganizationRole {
  org_owner
  org_admin
  member
  chef_owner
  chef_staff
  restaurant_owner
  restaurant_staff
  grocery_partner_admin
}

enum OrganizationType {
  household
  chef_business
  restaurant
  grocery_partner
  internal_admin
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum OrganizationStatus {
  active
  paused
  suspended
  disabled
}

enum MeasurementSystem {
  metric
  imperial
  mixed
}

enum UserStatus {
  active
  suspended
  disabled
}

model User {
  id                         String                  @id @default(cuid())
  email                      String                  @unique
  passwordHash               String
  fullName                   String
  status                     UserStatus              @default(active)
  platformRole               PlatformRole?
  preferredLocale            String?                 @default("en-US")
  preferredTimezone          String?                 @default("UTC")
  lastLoginAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  sessions                   Session[]
  memberships                Membership[]
  countryAssignments         CountryAssignment[]
  auditLogs                  AuditLog[]
  emailLogs                  EmailLog[]
  apiKeys                    ApiKey[]
  groceryLists               GroceryList[]
  createdMealPlans           MealPlan[]              @relation("MealPlanCreatedBy")
  videoAnalysesAnalyzedBy    RecipeVideoAnalysis[]   @relation("VideoAnalysisAnalyzedBy")
  videoAnalysesVerifiedBy    RecipeVideoAnalysis[]   @relation("VideoAnalysisVerifiedBy")
  videoAnalysisJobsRequested VideoAnalysisJob[]      @relation("VideoAnalysisJobRequestedBy")
  discoveryRuns              YouTubeDiscoveryRun[]   @relation("DiscoveryRunRequestedBy")
  reviewedCandidates         YouTubeVideoCandidate[] @relation("CandidateReviewedBy")
  favoriteRecipesCreated     FavoriteRecipe[]        @relation("FavoriteRecipeCreatedBy")
  aiTrainingExamplesCreated  AiTrainingExample[]     @relation("AiTrainingExampleCreatedBy")
  aiTrainingExamplesVerified AiTrainingExample[]     @relation("AiTrainingExampleVerifiedBy")
  aiTrainingDatasetsCreated  AiTrainingDataset[]     @relation("AiTrainingDatasetCreatedBy")
}

model Session {
  id                   String        @id @default(cuid())
  tokenHash            String        @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  organizationType     OrganizationType
  status               OrganizationStatus    @default(active)
  organizationId       String                @unique
  countryCode          String
  currencyCode         String
  defaultTimezone      String
  defaultLocale        String
  measurementSystem    MeasurementSystem
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  country              Country               @relation(fields: [countryCode], references: [countryCode])
  sessions             Session[]
  auditLogs            AuditLog[]
  featureFlags         FeatureFlag[]
  billingSubscriptions BillingSubscription[]
  apiKeys              ApiKey[]
  storageFiles         StorageFile[]
  emailLogs            EmailLog[]
  countryConfigs       CountryConfig[]
  groceryLists         GroceryList[]
  mealPlans            MealPlan[]
  mealPlanPreference   MealPlanPreference?
  householdProfile     HouseholdProfile?
  householdPreferences HouseholdPreference[]
  avoidedIngredients   AvoidedIngredient[]
  favoriteRecipes      FavoriteRecipe[]
  pantryItems          HouseholdPantryItem[]
  aiTrainingExamples   AiTrainingExample[]

  @@index([countryCode])
  @@index([status])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([status])
}

model Country {
  id                 String              @id @default(cuid())
  countryCode        String              @unique
  countryName        String
  currencyCode       String
  defaultTimezone    String
  defaultLocale      String
  measurementSystem  MeasurementSystem
  phoneCountryCode   String
  isActive           Boolean             @default(true)
  supportedModules   String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizations      Organization[]
  countryAssignments CountryAssignment[]
  countryConfigs     CountryConfig[]
  auditLogs          AuditLog[]
  mealPlans          MealPlan[]
}

model CountryAssignment {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([countryCode])
}

model CountryConfig {
  id                String             @id @default(cuid())
  organizationId    String?
  countryCode       String
  configKey         String
  configValue       Json
  measurementSystem MeasurementSystem?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryCode], references: [countryCode], onDelete: Cascade)

  @@unique([organizationId, countryCode, configKey])
  @@index([countryCode])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  countryCode    String?
  action         String
  targetType     String
  targetId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  country        Country?      @relation(fields: [countryCode], references: [countryCode], onDelete: SetNull)

  @@index([action])
  @@index([organizationId])
  @@index([countryCode])
  @@index([createdAt])
}

model FeatureFlag {
  id             String        @id @default(cuid())
  key            String
  name           String
  description    String?
  enabled        Boolean       @default(false)
  organizationId String?
  countryCode    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([key, organizationId, countryCode])
  @@index([organizationId])
  @@index([countryCode])
}

model BillingSubscription {
  id               String       @id @default(cuid())
  organizationId   String
  countryCode      String
  provider         String
  externalId       String?
  status           String
  planCode         String
  currencyCode     String
  billingPeriod    String
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([countryCode])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  keyHash        String
  label          String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model StorageFile {
  id             String       @id @default(cuid())
  organizationId String
  countryCode    String
  storageKey     String
  bucket         String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey])
  @@index([organizationId])
  @@index([countryCode])
}

model EmailLog {
  id                String        @id @default(cuid())
  organizationId    String?
  userId            String?
  countryCode       String?
  templateKey       String
  recipientEmail    String
  deliveryStatus    String
  providerMessageId String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([countryCode])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Food Foundation ─────────────────────────────────────────────────────────

enum UnitType {
  mass
  volume
  count
  length
  package
  custom
}

enum UnitSystem {
  metric
  imperial
  mixed
  traditional
}

enum IngredientCategory {
  vegetable
  fruit
  meat
  poultry
  seafood
  dairy
  grain
  lentil
  spice
  herb
  oil
  condiment
  nut
  sweetener
  beverage
  packaged
  other
}

enum RecipeDifficulty {
  easy
  medium
  hard
  expert
}

enum SpiceLevel {
  mild
  medium
  hot
  extra_hot
}

enum RecipeVisibility {
  global
  organization
  private
}

enum RecipeSourceType {
  platform
  organization
  imported
  user_created
}

enum MediaReferenceType {
  youtube
  image
  article
  other
}

enum MediaProvider {
  youtube
  manual
  other
}

enum VideoAnalysisSource {
  manual
  transcript_ai
  frames_ai
  transcript_and_frames_ai
  imported
}

enum VideoAnalysisVerificationStatus {
  ai_draft
  needs_review
  verified
  rejected
}

enum VideoAnalysisConfidence {
  exact
  high
  medium
  low
  unknown
}

enum VideoAnalysisJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum VideoAnalysisSourceType {
  youtube_reference
  pasted_transcript
  uploaded_video
  uploaded_audio
  manual
}

enum VideoRecipeDifferenceType {
  ingredient_difference
  quantity_difference
  step_difference
  timing_difference
  technique_difference
  spice_level_difference
  other
}

enum DifferenceSeverity {
  info
  warning
  important
}

enum AiTrainingExampleStatus {
  draft
  verified
  rejected
  exported
}

enum AiTrainingSourceType {
  manual
  ai_draft_corrected
  transcript
  video_analysis
  imported
}

enum AiTrainingTaskType {
  cooking_video_transcript_to_structured_analysis
  ingredient_extraction
  cooking_step_extraction
  recipe_difference_detection
}

enum AiTrainingDatasetStatus {
  draft
  ready
  exported
  archived
}

enum AiTrainingRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum AiModelType {
  local_rules
  local_finetune_placeholder
  local_http
  external_placeholder
}

enum YouTubeDiscoveryRunStatus {
  queued
  running
  completed
  failed
}

enum YouTubeVideoCandidateStatus {
  pending
  approved
  rejected
  imported
}

enum VideoAvailabilityStatus {
  unchecked
  available
  unavailable
  restricted
  unknown
}

enum CookingSkillLevel {
  beginner
  intermediate
  advanced
  expert
}

enum AvoidedIngredientSeverity {
  preference
  avoid
  strict
}

model Cuisine {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  countryCode String?
  isGlobal    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipes     Recipe[]

  @@index([countryCode])
}

model Unit {
  id                         String                    @id @default(cuid())
  code                       String                    @unique
  name                       String
  pluralName                 String
  type                       UnitType
  system                     UnitSystem
  symbol                     String?
  isBaseUnit                 Boolean                   @default(false)
  isGlobal                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  ingredients                Ingredient[]              @relation("IngredientDefaultUnit")
  recipeIngredients          RecipeIngredient[]
  conversionsFrom            UnitConversion[]          @relation("ConversionFromUnit")
  conversionsTo              UnitConversion[]          @relation("ConversionToUnit")
  groceryListItems           GroceryListItem[]
  originalGroceryItemSources GroceryListItemSource[]   @relation("SourceOriginalUnit")
  scaledGroceryItemSources   GroceryListItemSource[]   @relation("SourceScaledUnit")
  videoAnalysisIngredients   VideoAnalysisIngredient[]
  householdPantryItems       HouseholdPantryItem[]

  @@index([type])
  @@index([system])
}

model Ingredient {
  id                       String                     @id @default(cuid())
  organizationId           String?
  countryCode              String?
  name                     String
  canonicalName            String
  slug                     String
  category                 IngredientCategory
  defaultUnitId            String?
  densityGramPerMl         Float?
  averagePieceWeightGrams  Float?
  isGlobal                 Boolean                    @default(true)
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  defaultUnit              Unit?                      @relation("IngredientDefaultUnit", fields: [defaultUnitId], references: [id])
  aliases                  IngredientAlias[]
  recipeIngredients        RecipeIngredient[]
  unitConversions          UnitConversion[]
  groceryListItems         GroceryListItem[]
  groceryWarnings          GroceryConversionWarning[]
  videoAnalysisIngredients VideoAnalysisIngredient[]
  avoidedIngredients       AvoidedIngredient[]
  householdPantryItems     HouseholdPantryItem[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([category])
  @@index([isGlobal])
}

model IngredientAlias {
  id           String     @id @default(cuid())
  ingredientId String
  alias        String
  language     String?
  countryCode  String?
  confidence   Float      @default(1.0)
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([alias])
}

model UnitConversion {
  id           String      @id @default(cuid())
  fromUnitId   String
  toUnitId     String
  ingredientId String?
  multiplier   Float
  offset       Float?
  confidence   Float       @default(1.0)
  notes        String?
  isGlobal     Boolean     @default(true)
  countryCode  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  fromUnit     Unit        @relation("ConversionFromUnit", fields: [fromUnitId], references: [id])
  toUnit       Unit        @relation("ConversionToUnit", fields: [toUnitId], references: [id])
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([fromUnitId, toUnitId])
  @@index([ingredientId])
  @@index([isGlobal])
}

model Recipe {
  id                 String                     @id @default(cuid())
  organizationId     String?
  countryCode        String?
  cuisineId          String
  name               String
  slug               String
  description        String?
  story              String?
  difficulty         RecipeDifficulty
  spiceLevel         SpiceLevel
  prepMinutes        Int
  cookMinutes        Int
  restMinutes        Int?
  servings           Int
  servingUnit        String                     @default("serving")
  visibility         RecipeVisibility           @default(global)
  sourceType         RecipeSourceType
  createdById        String?
  isGlobal           Boolean                    @default(false)
  isPublished        Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  cuisine            Cuisine                    @relation(fields: [cuisineId], references: [id])
  ingredients        RecipeIngredient[]
  steps              RecipeStep[]
  mediaRefs          RecipeMediaReference[]
  dietaryTags        RecipeDietaryTag[]
  groceryListRecipes GroceryListRecipe[]
  groceryItemSources GroceryListItemSource[]
  groceryWarnings    GroceryConversionWarning[]
  mealPlanEntries    MealPlanEntry[]
  videoAnalyses      RecipeVideoAnalysis[]
  videoAnalysisJobs  VideoAnalysisJob[]
  discoveryRuns      YouTubeDiscoveryRun[]
  youtubeCandidates  YouTubeVideoCandidate[]
  favoriteRecipes    FavoriteRecipe[]
  aiTrainingExamples AiTrainingExample[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([cuisineId])
  @@index([isPublished])
  @@index([visibility])
}

model RecipeIngredient {
  id              String     @id @default(cuid())
  recipeId        String
  ingredientId    String
  quantity        Float
  unitId          String
  preparationNote String?
  section         String?
  isOptional      Boolean    @default(false)
  displayOrder    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  recipe          Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  unit            Unit       @relation(fields: [unitId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeStep {
  id              String  @id @default(cuid())
  recipeId        String
  stepNumber      Int
  title           String?
  instruction     String
  durationMinutes Int?
  temperature     String?
  tips            String?
  displayOrder    Int     @default(0)
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId])
}

model RecipeMediaReference {
  id                        String                  @id @default(cuid())
  recipeId                  String
  type                      MediaReferenceType
  provider                  MediaProvider           @default(manual)
  title                     String
  url                       String
  normalizedUrl             String?
  embedUrl                  String?
  externalId                String?
  thumbnailUrl              String?
  language                  String?
  creatorName               String?
  durationSeconds           Int?
  isPrimary                 Boolean                 @default(false)
  displayOrder              Int                     @default(0)
  notes                     String?
  availabilityStatus        VideoAvailabilityStatus @default(unchecked)
  lastAvailabilityCheckedAt DateTime?
  unavailableReason         String?
  isEmbeddable              Boolean                 @default(false)
  isPublic                  Boolean                 @default(false)
  uploadStatus              String?
  liveBroadcastContent      String?
  qualityDefinition         String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  recipe                    Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  videoAnalyses             RecipeVideoAnalysis[]
  analysisJobs              VideoAnalysisJob[]
  trainingExamples          AiTrainingExample[]

  @@index([recipeId])
  @@index([isPrimary])
}

model DietaryTag {
  id      String             @id @default(cuid())
  name    String             @unique
  slug    String             @unique
  recipes RecipeDietaryTag[]
}

model RecipeDietaryTag {
  recipeId     String
  dietaryTagId String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietaryTagId])
}

model MealTypeOption {
  id           String @id @default(cuid())
  name         String @unique
  slug         String @unique
  displayOrder Int    @default(0)
}

// ─── Grocery Engine ───────────────────────────────────────────────────────────

enum MealPlanStatus {
  draft
  active
  completed
  archived
}

enum MealPlanEntryStatus {
  planned
  cooked
  skipped
  ordered_instead
  replaced
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  dessert
  side
  prep
}

enum GroceryListStatus {
  draft
  active
  completed
  archived
}

enum GroceryListSourceType {
  manual
  recipes
  meal_plan
}

enum GroceryMergeStatus {
  merged
  separate
  needs_review
  conversion_failed
}

enum GroceryConfidence {
  exact
  high
  medium
  low
  unknown
}

enum WarningSeverity {
  info
  warning
  error
}

model GroceryList {
  id                 String                     @id @default(cuid())
  organizationId     String
  countryCode        String?
  createdById        String
  mealPlanId         String?
  name               String
  status             GroceryListStatus          @default(draft)
  sourceType         GroceryListSourceType      @default(recipes)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  householdSize      Int?
  notes              String?
  calculationVersion Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  organization       Organization               @relation(fields: [organizationId], references: [id])
  createdBy          User                       @relation(fields: [createdById], references: [id])
  mealPlan           MealPlan?                  @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  recipes            GroceryListRecipe[]
  items              GroceryListItem[]
  warnings           GroceryConversionWarning[]

  @@index([organizationId])
  @@index([createdById])
  @@index([mealPlanId])
  @@index([status])
}

model MealPlan {
  id             String         @id @default(cuid())
  organizationId String
  countryCode    String
  createdById    String
  name           String
  status         MealPlanStatus @default(draft)
  startDate      DateTime
  endDate        DateTime
  householdSize  Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country        Country        @relation(fields: [countryCode], references: [countryCode], onDelete: Restrict)
  createdBy      User           @relation("MealPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  days           MealPlanDay[]
  groceryLists   GroceryList[]

  @@index([organizationId])
  @@index([countryCode])
  @@index([createdById])
  @@index([status])
  @@index([startDate, endDate])
}

model MealPlanDay {
  id         String          @id @default(cuid())
  mealPlanId String
  date       DateTime
  dayLabel   String?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  mealPlan   MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  entries    MealPlanEntry[]

  @@unique([mealPlanId, date])
  @@index([date])
}

model MealPlanEntry {
  id             String              @id @default(cuid())
  mealPlanDayId  String
  recipeId       String?
  customMealName String?
  mealType       MealType
  targetServings Int
  notes          String?
  status         MealPlanEntryStatus @default(planned)
  displayOrder   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  mealPlanDay    MealPlanDay         @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  recipe         Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([mealPlanDayId])
  @@index([recipeId])
  @@index([mealType])
  @@index([status])
}

model MealPlanPreference {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  defaultHouseholdSize Int?
  defaultCountryCode   String?
  preferredCuisines    String[]
  avoidedIngredients   String[]
  spicePreference      SpiceLevel?
  dietaryNotes         String?
  weeklyCookingDays    String[]
  measurementSystem    MeasurementSystem?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([defaultCountryCode])
}

model HouseholdProfile {
  id                         String            @id @default(cuid())
  organizationId             String            @unique
  countryCode                String
  displayName                String
  defaultHouseholdSize       Int
  adultsCount                Int?
  childrenCount              Int?
  defaultServings            Int
  defaultSpiceLevel          SpiceLevel
  preferredMeasurementSystem MeasurementSystem
  preferredCuisineIds        String[]
  cookingSkillLevel          CookingSkillLevel
  weeklyCookingDays          String[]
  groceryBudgetAmount        Float?
  groceryBudgetCurrency      String?
  notes                      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  organization               Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([countryCode])
}

model HouseholdPreference {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  valueJson      Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model AvoidedIngredient {
  id             String                    @id @default(cuid())
  organizationId String
  ingredientId   String?
  ingredientName String
  reason         String?
  severity       AvoidedIngredientSeverity @default(avoid)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient     Ingredient?               @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ingredientId])
}

model FavoriteRecipe {
  id             String       @id @default(cuid())
  organizationId String
  recipeId       String
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipe         Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("FavoriteRecipeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, recipeId])
  @@index([organizationId])
  @@index([recipeId])
}

model HouseholdPantryItem {
  id             String       @id @default(cuid())
  organizationId String
  ingredientId   String
  quantity       Float?
  unitId         String?
  notes          String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ingredientId])
  @@index([expiresAt])
}

model GroceryListRecipe {
  id                 String      @id @default(cuid())
  groceryListId      String
  recipeId           String
  recipeNameSnapshot String
  originalServings   Int
  targetServings     Int
  scaleFactor        Float
  mealSlot           String?
  plannedDate        DateTime?
  createdAt          DateTime    @default(now())
  groceryList        GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  recipe             Recipe      @relation(fields: [recipeId], references: [id])

  @@index([groceryListId])
  @@index([recipeId])
}

model GroceryListItem {
  id                      String                  @id @default(cuid())
  groceryListId           String
  ingredientId            String
  ingredientNameSnapshot  String
  canonicalIngredientName String
  category                String
  totalQuantity           Float
  unitId                  String
  unitNameSnapshot        String
  displayQuantity         Float
  displayUnit             String
  confidence              GroceryConfidence       @default(unknown)
  mergeStatus             GroceryMergeStatus      @default(separate)
  notes                   String?
  isChecked               Boolean                 @default(false)
  sortOrder               Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  groceryList             GroceryList             @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient              Ingredient              @relation(fields: [ingredientId], references: [id])
  unit                    Unit                    @relation(fields: [unitId], references: [id])
  sources                 GroceryListItemSource[]

  @@index([groceryListId])
  @@index([ingredientId])
  @@index([isChecked])
}

model GroceryListItemSource {
  id                       String          @id @default(cuid())
  groceryListItemId        String
  recipeId                 String
  recipeNameSnapshot       String
  recipeIngredientId       String?
  originalQuantity         Float
  originalUnitId           String
  originalUnitNameSnapshot String
  scaledQuantity           Float
  scaledUnitId             String
  scaledUnitNameSnapshot   String
  conversionApplied        Boolean         @default(false)
  conversionConfidence     Float           @default(1.0)
  warning                  String?
  createdAt                DateTime        @default(now())
  groceryListItem          GroceryListItem @relation(fields: [groceryListItemId], references: [id], onDelete: Cascade)
  recipe                   Recipe          @relation(fields: [recipeId], references: [id])
  originalUnit             Unit            @relation("SourceOriginalUnit", fields: [originalUnitId], references: [id])
  scaledUnit               Unit            @relation("SourceScaledUnit", fields: [scaledUnitId], references: [id])

  @@index([groceryListItemId])
  @@index([recipeId])
}

model GroceryConversionWarning {
  id               String          @id @default(cuid())
  groceryListId    String
  ingredientId     String?
  message          String
  severity         WarningSeverity @default(warning)
  sourceRecipeId   String?
  sourceRecipeName String?
  createdAt        DateTime        @default(now())
  groceryList      GroceryList     @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient       Ingredient?     @relation(fields: [ingredientId], references: [id])
  sourceRecipe     Recipe?         @relation(fields: [sourceRecipeId], references: [id])

  @@index([groceryListId])
  @@index([ingredientId])
}

// ─── Video Analysis ───────────────────────────────────────────────────────────

model RecipeVideoAnalysis {
  id                     String                          @id @default(cuid())
  recipeMediaReferenceId String
  recipeId               String
  organizationId         String?
  countryCode            String?
  title                  String
  summary                String?
  analysisSource         VideoAnalysisSource
  aiProvider             String?
  aiModel                String?
  promptVersion          String                          @default("v1")
  verificationStatus     VideoAnalysisVerificationStatus @default(ai_draft)
  confidence             VideoAnalysisConfidence         @default(unknown)
  analyzedByUserId       String?
  verifiedByUserId       String?
  verifiedAt             DateTime?
  rawTranscriptProvided  Boolean                         @default(false)
  framesAnalyzedCount    Int?
  analysisCostCents      Int?
  errorMessage           String?
  notes                  String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  mediaReference         RecipeMediaReference            @relation(fields: [recipeMediaReferenceId], references: [id], onDelete: Cascade)
  recipe                 Recipe                          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  analyzedBy             User?                           @relation("VideoAnalysisAnalyzedBy", fields: [analyzedByUserId], references: [id], onDelete: SetNull)
  verifiedBy             User?                           @relation("VideoAnalysisVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  ingredients            VideoAnalysisIngredient[]
  steps                  VideoAnalysisStep[]
  differences            VideoRecipeDifference[]
  trainingExamples       AiTrainingExample[]

  @@index([recipeMediaReferenceId])
  @@index([recipeId])
  @@index([organizationId])
  @@index([verificationStatus])
}

model VideoAnalysisIngredient {
  id                       String                  @id @default(cuid())
  videoAnalysisId          String
  ingredientId             String?
  ingredientName           String
  normalizedIngredientName String?
  quantity                 Float?
  unitId                   String?
  unitName                 String?
  preparationNote          String?
  timestampStartSeconds    Int?
  timestampEndSeconds      Int?
  confidence               VideoAnalysisConfidence @default(unknown)
  evidenceText             String?
  evidenceFrameTimestamp   Int?
  notes                    String?
  displayOrder             Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  videoAnalysis            RecipeVideoAnalysis     @relation(fields: [videoAnalysisId], references: [id], onDelete: Cascade)
  ingredient               Ingredient?             @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  unit                     Unit?                   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([videoAnalysisId])
  @@index([ingredientId])
}

model VideoAnalysisStep {
  id                     String                  @id @default(cuid())
  videoAnalysisId        String
  stepNumber             Int
  title                  String?
  description            String
  timestampStartSeconds  Int?
  timestampEndSeconds    Int?
  durationSeconds        Int?
  temperature            String?
  technique              String?
  confidence             VideoAnalysisConfidence @default(unknown)
  evidenceText           String?
  evidenceFrameTimestamp Int?
  notes                  String?
  displayOrder           Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  videoAnalysis          RecipeVideoAnalysis     @relation(fields: [videoAnalysisId], references: [id], onDelete: Cascade)

  @@index([videoAnalysisId])
}

model VideoRecipeDifference {
  id              String                    @id @default(cuid())
  videoAnalysisId String
  differenceType  VideoRecipeDifferenceType
  title           String
  description     String
  severity        DifferenceSeverity        @default(info)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  videoAnalysis   RecipeVideoAnalysis       @relation(fields: [videoAnalysisId], references: [id], onDelete: Cascade)

  @@index([videoAnalysisId])
}

model VideoAnalysisJob {
  id                     String                  @id @default(cuid())
  recipeMediaReferenceId String
  recipeId               String
  organizationId         String?
  requestedByUserId      String
  status                 VideoAnalysisJobStatus  @default(queued)
  sourceType             VideoAnalysisSourceType
  transcriptText         String?
  uploadedFileId         String?
  errorMessage           String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  mediaReference         RecipeMediaReference    @relation(fields: [recipeMediaReferenceId], references: [id], onDelete: Cascade)
  recipe                 Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  requestedBy            User                    @relation("VideoAnalysisJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([recipeMediaReferenceId])
  @@index([recipeId])
  @@index([organizationId])
  @@index([status])
}

// ─── AI Training Foundation ──────────────────────────────────────────────────

model AiTrainingExample {
  id                     String                     @id @default(cuid())
  organizationId         String?
  countryCode            String?
  recipeId               String?
  recipeMediaReferenceId String?
  recipeVideoAnalysisId  String?
  createdByUserId        String
  verifiedByUserId       String?
  status                 AiTrainingExampleStatus    @default(draft)
  sourceType             AiTrainingSourceType
  taskType               AiTrainingTaskType
  inputJson              Json
  expectedOutputJson     Json
  notes                  String?
  qualityScore           Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  verifiedAt             DateTime?
  organization           Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recipe                 Recipe?                    @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeMediaReference   RecipeMediaReference?      @relation(fields: [recipeMediaReferenceId], references: [id], onDelete: SetNull)
  recipeVideoAnalysis    RecipeVideoAnalysis?       @relation(fields: [recipeVideoAnalysisId], references: [id], onDelete: SetNull)
  createdBy              User                       @relation("AiTrainingExampleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  verifiedBy             User?                      @relation("AiTrainingExampleVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  datasetExamples        AiTrainingDatasetExample[]

  @@unique([recipeVideoAnalysisId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([recipeId])
  @@index([status])
  @@index([taskType])
}

model AiTrainingDataset {
  id              String                     @id @default(cuid())
  name            String
  description     String?
  status          AiTrainingDatasetStatus    @default(draft)
  taskType        AiTrainingTaskType
  exampleCount    Int                        @default(0)
  version         Int                        @default(1)
  createdByUserId String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  createdBy       User                       @relation("AiTrainingDatasetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  examples        AiTrainingDatasetExample[]
  runs            AiTrainingRun[]

  @@index([status])
  @@index([taskType])
}

model AiTrainingDatasetExample {
  id        String            @id @default(cuid())
  datasetId String
  exampleId String
  createdAt DateTime          @default(now())
  dataset   AiTrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  example   AiTrainingExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@unique([datasetId, exampleId])
  @@index([exampleId])
}

model AiTrainingRun {
  id                 String              @id @default(cuid())
  datasetId          String
  status             AiTrainingRunStatus @default(queued)
  modelType          AiModelType
  baseModel          String?
  outputModelPath    String?
  trainingConfigJson Json
  metricsJson        Json?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dataset            AiTrainingDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([status])
}

// ─── YouTube Discovery ────────────────────────────────────────────────────────

model YouTubeDiscoveryRun {
  id                String                    @id @default(cuid())
  recipeId          String?
  organizationId    String?
  countryCode       String?
  requestedByUserId String
  status            YouTubeDiscoveryRunStatus @default(queued)
  queryCount        Int                       @default(0)
  candidatesFound   Int                       @default(0)
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  recipe            Recipe?                   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  requestedBy       User                      @relation("DiscoveryRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  candidates        YouTubeVideoCandidate[]

  @@index([recipeId])
  @@index([organizationId])
  @@index([status])
}

model YouTubeVideoCandidate {
  id                        String                      @id @default(cuid())
  discoveryRunId            String
  recipeId                  String
  providerVideoId           String
  title                     String
  description               String?
  channelId                 String?
  channelTitle              String?
  thumbnailUrl              String?
  publishedAt               DateTime?
  durationSeconds           Int?
  viewCount                 BigInt?
  likeCount                 BigInt?
  commentCount              BigInt?
  searchQuery               String
  score                     Float                       @default(0)
  scoreReasonsJson          Json                        @default("[]")
  professionalSignalsJson   Json                        @default("[]")
  rejectionReasonsJson      Json?
  status                    YouTubeVideoCandidateStatus @default(pending)
  reviewedByUserId          String?
  reviewedAt                DateTime?
  availabilityStatus        VideoAvailabilityStatus     @default(unchecked)
  lastAvailabilityCheckedAt DateTime?
  unavailableReason         String?
  isEmbeddable              Boolean                     @default(false)
  isPublic                  Boolean                     @default(false)
  uploadStatus              String?
  liveBroadcastContent      String?
  qualityDefinition         String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  discoveryRun              YouTubeDiscoveryRun         @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  recipe                    Recipe                      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reviewedBy                User?                       @relation("CandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([recipeId, providerVideoId])
  @@index([discoveryRunId])
  @@index([recipeId])
  @@index([status])
}
